{
  "name": "@prem_gaikwad/easeui",
  "version": "1.0.11",
  "description": "A Neo-Brutalist React UI component library with bold colors, hard shadows, and GSAP animations",
  "author": "Prem Gaikwad",
  "license": "MIT",
  "keywords": [
    "react",
    "ui",
    "component-library",
    "neo-brutalist",
    "tailwindcss",
    "gsap",
    "animation",
    "design-system",
    "easeui"
  ],
  "homepage": "https://github.com/Prem759-0/EaseUi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prem759-0/EaseUi.git"
  },
  "bugs": {
    "url": "https://github.com/Prem759-0/EaseUi/issues"
  },
  "main": "dist/easeui.umd.js",
  "module": "dist/easeui.es.js",
  "types": "dist/types/index.d.ts",
  "bin": {
    "easeui": "./cli/index.js"
  },
  "files": [
    "dist",
    "cli",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/easeui.es.js",
      "require": "./dist/easeui.umd.js"
    },
    "./style.css": "./dist/index.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.lib.json",
    "build:docs": "vite build -c vite.docs.config.ts",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "commander": "^15.0.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "react-aria-components": "^1.20.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@reduxjs/toolkit": "^2.9.2",
    "@tailwindcss/vite": "^4.1.16",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "lucide-react": "^0.544.0",
    "react-redux": "^9.2.0",
    "react-router": "^7.9.5",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.8.3",
    "vite": "^7.1.7"
  }
}
